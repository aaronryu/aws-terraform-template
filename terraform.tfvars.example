# 이 파일을 terraform.tfvars 로 복사해서 값을 채우세요. (terraform.tfvars 는 .gitignore 대상)
#   cp terraform.tfvars.example terraform.tfvars

environment             = "dev"
project_name            = "tf-practice"
target_instance_port    = 8080

# 개발하는 여러분들의 집이나 자주가는 카페의 Public IP 추가하여 Bastion 에 접근할 수 있도록 오픈
#   - Private Subnet 내 위치한 AWS EC2 혹은 AWS RDS 모두 직접 SSH 으로 붙을 수 없고 특정 IP 에 오픈된 Bastion 통해서만 접근가능
ips_for_develop_purpose = [
  # "112.216.230.34/32", # Jibmusil IP
  "218.156.176.28/32",
]

# S3 애 자바스크립트로 호출 가능한 도메인과 메서드명
cors_allowed_methods = ["GET", "HEAD"]
cors_allowed_origins = [
  "http://localhost:8080"
]

# ECS 내 컨테이너 자원 사양을 바꿀때
# ecs_task_cpu    = 512
# ecs_task_memory = 1024